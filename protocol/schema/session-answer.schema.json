{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xworkmate.dev/remote-desktop/v1/session-answer.schema.json",
  "title": "Remote Desktop Session Answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "sessionId", "sdpAnswer"],
  "properties": {
    "protocolVersion": {"const": "1"},
    "sessionId": {"type": "string", "minLength": 1},
    "sdpAnswer": {"type": "string", "minLength": 1}
  }
}
